<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: Nút Trở về, LingoPro, Avatar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_revert"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:tint="#1A73E8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/imgBack"
                android:text="LingoPro"
                android:textColor="#1A73E8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Icon ảnh đại diện bên phải -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/nen_icon_hinh_tron"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_camera"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- Lời chào mừng -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Chào mừng bạn."
            android:textColor="#111827"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Bắt đầu hành trình chinh phục ngôn ngữ cùng LingoPro."
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <!-- Form Đăng Nhập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/nen_goc_24" android:backgroundTint="#F3F5F9"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÊN ĐĂNG NHẬP"
                android:textColor="#1A73E8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Khung nhập Tài khoản -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/nen_goc_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    app:tint="#9CA3AF" />

                <EditText
                    android:id="@+id/edtTaiKhoan"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Nhập tài khoản của bạn"
                    android:inputType="textEmailAddress"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="MẬT KHẨU"
                android:textColor="#1A73E8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Khung nhập Mật khẩu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/nen_goc_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bieu_tuong_khoa" />

                <EditText
                    android:id="@+id/edtMatKhau"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imgHienThiMatKhau"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/bieu_tuong_con_mat" />
            </LinearLayout>

            <!-- Quên mật khẩu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:text="Quên mật khẩu?"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <!-- Nút Đăng nhập -->
            <Button
                android:id="@+id/btnDangNhap"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/nen_nut_mau_xanh"
                android:text="Đăng nhập →"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:backgroundTint="@null" />

            <!-- Dòng chữ HOẶC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E5E7EB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="HOẶC"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E5E7EB" />
            </LinearLayout>

            <!-- Các nút Mạng xã hội -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Giả lập nút Google -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/nen_icon_hinh_tron"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_search"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    app:tint="#1A73E8" />

                <!-- Giả lập nút Facebook/Khác -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/nen_icon_hinh_tron"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_share"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    app:tint="#1A73E8" />
            </LinearLayout>

        </LinearLayout>

        <!-- Chuyển sang Đăng ký -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn mới biết đến LingoPro? "
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDangKyNgay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng ký"
                android:textColor="#1A73E8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="© 2024 LingoPro. Tất cả quyền được bảo lưu."
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

